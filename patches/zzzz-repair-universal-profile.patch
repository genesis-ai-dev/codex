+	/** A universal VSIX may already be installed under the unsuffixed directory name. */
+	private async resolveStaleUniversalLocation(entry: IStoredProfileExtension, location: URI): Promise<URI | undefined> {
+		const extUri = this.uriIdentityService.extUri;
+		const basename = extUri.basename(location);
+		const expected = entry.identifier.id.toLowerCase() + '-' + entry.version;
+		const moved = !this.toRelativePath(location);
+		if (location.scheme !== this.extensionsLocation.scheme || location.authority !== this.extensionsLocation.authority ||
+			(basename !== expected + '-universal' && !(moved && basename === expected)) ||
+			(entry.metadata?.targetPlatform && entry.metadata.targetPlatform !== TargetPlatform.UNIVERSAL)) {
+			return undefined;
+		}
+		try {
+			await this.fileService.stat(extUri.joinPath(location, 'package.json'));
+			return undefined;
+		} catch (error) {
+			if (toFileOperationResult(error) !== FileOperationResult.FILE_NOT_FOUND) { return undefined; }
+		}
+		// An absolute-only profile entry may predate a change of account or extensions directory.
+		// Resolve replacements exclusively inside this instance's configured extension store.
+		const names = moved ? [basename, basename === expected ? expected + '-universal' : expected] : [expected];
+		for (const name of names) {
+			const candidate = this.resolveExtensionLocation(name);
+			try {
+				const file = await this.fileService.readFile(extUri.joinPath(candidate, 'package.json'));
+				const manifest = JSON.parse(file.value.toString());
+				if (typeof manifest.publisher === 'string' && typeof manifest.name === 'string'
+					&& (manifest.publisher + '.' + manifest.name).toLowerCase() === entry.identifier.id.toLowerCase()
+					&& manifest.version === entry.version
+					&& (!manifest.__metadata?.targetPlatform || manifest.__metadata.targetPlatform === TargetPlatform.UNIVERSAL)) {
+					return candidate;
+				}
+			} catch { /* Only use a verified replacement. */ }
+		}
+		return undefined;
+	}
+
 	private throwInvalidConentError(file: URI): void {
 		throw new ExtensionsProfileScanningError(`Invalid extensions content in ${file.toString()}`, ExtensionsProfileScanningErrorCode.ERROR_INVALID_CONTENT);
 	}
