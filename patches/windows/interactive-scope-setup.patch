@@ -1305,6 +1305,77 @@
 end;
 
 // Don't allow installing conflicting architectures
+var
+  PlanFile: String;
+  ScopePage: TInputOptionWizardPage;
+  FolderPage: TInputDirWizardPage;
+  LastScope: Integer;
+  PlanComplete: Boolean;
+
+function FromScopeLauncher(): Boolean;
+begin
+  Result := ExpandConstant('{param:CodexScopeSetup|0}') = '1';
+end;
+
+procedure InitializeWizard();
+begin
+#if "user" == InstallTarget
+  PlanFile := ExpandConstant('{param:CodexPlan|}');
+  if PlanFile <> '' then begin
+    LastScope := -1;
+    ScopePage := CreateInputOptionPage(wpLicense, 'Select Installation Scope',
+      'Who should Codex be installed for?', 'Select an installation scope. All Users requires administrator access.', True, False);
+    ScopePage.Add(GetIniString('setup', 'userLabel', 'Current User', PlanFile));
+    ScopePage.Add(GetIniString('setup', 'systemLabel', 'All Users', PlanFile));
+    ScopePage.SelectedValueIndex := GetIniInt('setup', 'default', 0, 0, 1, PlanFile);
+    FolderPage := CreateInputDirPage(ScopePage.ID, SetupMessage(msgWizardSelectDir),
+      'Choose the destination folder for Codex.', 'Setup will install Codex in the following folder.', False, '');
+    FolderPage.Add('');
+  end;
+#endif
+end;
+
+procedure CurPageChanged(CurPageID: Integer);
+var Key: String; Editable: Boolean;
+begin
+  if PlanFile = '' then Exit;
+  if CurPageID <> FolderPage.ID then Exit;
+  if ScopePage.SelectedValueIndex = 1 then Key := 'system' else Key := 'user';
+  if LastScope <> ScopePage.SelectedValueIndex then
+    FolderPage.Values[0] := GetIniString('setup', Key, '', PlanFile);
+  LastScope := ScopePage.SelectedValueIndex;
+  Editable := GetIniString('setup', Key + 'Fixed', '1', PlanFile) = '0';
+  FolderPage.Edits[0].ReadOnly := not Editable;
+  FolderPage.Buttons[0].Enabled := Editable;
+end;
+
+function NextButtonClick(CurPageID: Integer): Boolean;
+var Lines: TArrayOfString;
+begin
+  Result := True;
+  if PlanFile = '' then Exit;
+  if CurPageID <> FolderPage.ID then Exit;
+  Result := False;
+  SetArrayLength(Lines, 2);
+  if ScopePage.SelectedValueIndex = 1 then Lines[0] := 'system' else Lines[0] := 'user';
+  Lines[1] := FolderPage.Values[0];
+  if not SaveStringsToUTF8File(PlanFile, Lines, False) then
+    RaiseException('Could not save the installation choice.');
+  PlanComplete := True;
+  WizardForm.Close;
+end;
+
+procedure CancelButtonClick(CurPageID: Integer; var Cancel, Confirm: Boolean);
+begin
+  if PlanComplete then begin Cancel := True; Confirm := False; end;
+end;
+
+function ShouldSkipPage(PageID: Integer): Boolean;
+begin
+  Result := FromScopeLauncher() and ((PageID = wpSelectDir) or
+    ((PageID = wpLicense) and (ExpandConstant('{param:CodexAcceptedLicense|0}') = '1')));
+end;
+
 function InitializeSetup(): Boolean;
