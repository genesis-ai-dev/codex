+function ScopeSetupMutex(Value: String): String;
+begin
+  if ExpandConstant('{param:CodexPlan|}') <> '' then Result := '{#AppMutex}wizard'
+  else Result := '{#AppMutex}setup';
+end;
+
+function FromScopeLauncher(): Boolean;
+begin
+  Result := ExpandConstant('{param:CodexScopeSetup|0}') = '1';
+end;
+
+procedure UpdateDefaultsButton(Sender: TObject);
+begin
+  DefaultsButton.Enabled := WizardSelectedTasks(False) <> DefaultTasks;
+end;
+
+procedure RestoreTaskDefaults(Sender: TObject);
+begin
+  WizardSelectTasks('!desktopicon,!quicklaunchicon,!addcontextmenufiles,!addcontextmenufolders,!associatewithfiles,!addtopath');
+  WizardSelectTasks(DefaultTasks);
+  UpdateDefaultsButton(nil);
+end;
+
+function PutWindowValue(W: HWND; Name: String; Value: Integer): Boolean;
+  external 'SetPropW@user32.dll stdcall';
+function WindowValue(W: HWND; Name: String): Integer;
+  external 'GetPropW@user32.dll stdcall';
+function ReadCaption(W: HWND; Buffer: String; Count: Integer): Integer;
+  external 'GetWindowTextW@user32.dll stdcall';
+function StartTimer(W: HWND; ID, Interval: LongWord; Callback: LongWord): LongWord;
+  external 'SetTimer@user32.dll stdcall';
+function StopTimer(W: HWND; ID: LongWord): Boolean;
+  external 'KillTimer@user32.dll stdcall';
+
+procedure CurInstallProgressChanged(CurProgress, MaxProgress: Integer);
+begin
+  if not Reporting then Exit;
+  if not CancelRequested and (CurProgress < MaxProgress) and
+     (FindWindowByWindowName('Codex Cancel ' + Channel) <> 0) then begin
+    CancelRequested := True;
+    { Inno only accepts a native Close during extraction on a visible form.
+      Keep the silent worker off screen while it starts its normal rollback. }
+    WizardForm.Left := -32000;
+    WizardForm.Top := -32000;
+    WizardForm.Show;
+    WizardForm.Close;
+    WizardForm.Hide;
+  end;
+  ProgressFile.Caption := WizardForm.FilenameLabel.Caption;
+  PutWindowValue(WizardForm.Handle, 'CodexMaximum', MaxProgress);
+  PutWindowValue(WizardForm.Handle, 'CodexPosition', CurProgress);
+end;
+
+procedure RefreshProgress(W: HWND; Msg, ID, Time: LongWord);
+var Worker: HWND; Maximum, Position, N: Integer; Filename: String;
+begin
+  if Displaying then Exit;
+  Displaying := True;
+  try
+    Worker := FindWindowByWindowName('Codex Setup Progress ' + Session);
+    Maximum := WindowValue(Worker, 'CodexMaximum');
+    WizardForm.CancelButton.Enabled := not CancelRequested and (Maximum > 0) and
+      (WindowValue(Worker, 'CodexPosition') < Maximum);
+    if CancelRequested then begin
+      Progress.SetText('Waiting for setup to cancel...', '');
+      Exit;
+    end;
+    if Maximum > 0 then begin
+      Position := WindowValue(Worker, 'CodexPosition');
+      SetLength(Filename, 1024);
+      N := ReadCaption(WindowValue(Worker, 'CodexFile'), Filename, Length(Filename));
+      SetLength(Filename, N);
+      if Filename <> '' then Progress.SetText(SetupMessage(msgStatusExtractFiles), Filename)
+      else Progress.SetText('Installing Codex...', '');
+      Progress.SetProgress(Position, Maximum);
+    end else if Progress.ProgressBar.Position > 0 then
+      Progress.SetText('Finishing setup...', '');
+  finally
+    Displaying := False;
+  end;
+end;
+
+procedure InitializeWizard();
+begin
+  Channel := ExpandConstant('{param:CodexProgress|}');
+  if WizardSilent and (Channel <> '') then begin
+    ProgressFile := CreateCustomForm;
+    WizardForm.Caption := 'Codex Setup Progress ' + Channel;
+    PutWindowValue(WizardForm.Handle, 'CodexFile', ProgressFile.Handle);
+    Reporting := True;
+  end;
+#if "user" == InstallTarget
+  PlanFile := ExpandConstant('{param:CodexPlan|}');
+  if PlanFile <> '' then begin
+    if IsAdmin then RaiseException('Start Codex Setup from your normal Windows session.');
+    WizardForm.Caption := 'Setup - Codex';
+    Launcher := GetIniString('setup', 'launcher', '', PlanFile);
+    Session := GetIniString('setup', 'session', '', PlanFile);
+    ScopePage := CreateInputOptionPage(wpLicense, 'Select Installation Scope',
+      'Who should Codex be installed for?', 'Choose who can use Codex. Changing scope replaces the existing copy and may require administrator access.', True, False);
+    ScopePage.Add(GetIniString('setup', 'userLabel', 'Current User', PlanFile));
+    ScopePage.Add(GetIniString('setup', 'systemLabel', 'All Users', PlanFile));
+    ScopePage.SelectedValueIndex := GetIniInt('setup', 'default', 0, 0, 1, PlanFile);
+    DefaultsButton := TNewButton.Create(WizardForm);
+    DefaultsButton.Parent := WizardForm.TasksList.Parent;
+    DefaultsButton.Caption := 'Restore defaults';
+    DefaultsButton.SetBounds(WizardForm.TasksList.Left, WizardForm.TasksList.Top + WizardForm.TasksList.Height - ScaleY(24), ScaleX(104), ScaleY(24));
+    WizardForm.TasksList.Height := WizardForm.TasksList.Height - ScaleY(32);
+    WizardForm.TasksList.OnClickCheck := @UpdateDefaultsButton;
+    DefaultsButton.OnClick := @RestoreTaskDefaults;
+    Progress := CreateOutputProgressPage('Installing Codex', 'Please wait while Setup installs Codex.');
+  end;
+#endif
+end;
+
+function Request(Command, Value: String): Boolean;
+var Status: Integer;
+begin
+  Result := Exec(Launcher, '/wizard-request ' + Session + ' ' + Command + ' "' + Value + '"',
+    '', SW_HIDE, ewWaitUntilTerminated, Status) and (Status = 0);
+end;
+
+procedure CurPageChanged(CurPageID: Integer);
+var Review: TArrayOfString; I: Integer; Saved: String;
+begin
+  if PlanFile = '' then Exit;
+  if CurPageID = wpSelectTasks then begin
+    if ScopePage.SelectedValueIndex = 1 then Saved := GetIniString('setup', 'systemTasks', '', PlanFile)
+    else Saved := GetIniString('setup', 'userTasks', '', PlanFile);
+    if not TasksInitialized then begin
+      DefaultTasks := WizardSelectedTasks(False);
+      TasksInitialized := True;
+    end;
+    RestoreTaskDefaults(nil);
+    WizardSelectTasks(Saved);
+    UpdateDefaultsButton(nil);
+  end;
+  if CurPageID = wpReady then begin
+    if not LoadStringsFromFile(PlanFile + '.migration', Review) then
+      RaiseException('Could not read the installation summary.');
+    if GetArrayLength(Review) > 0 then begin
+      WizardForm.ReadyMemo.Lines.Add('');
+      for I := 0 to GetArrayLength(Review) - 1 do WizardForm.ReadyMemo.Lines.Add(Review[I]);
+    end;
+  end;
+  if (CurPageID = ScopePage.ID) and ScopeAuthorized then begin
+    Request('release', '');
+    ScopeAuthorized := False;
+  end;
+end;
+
+function NextButtonClick(CurPageID: Integer): Boolean;
+var Scope: String; Details: TArrayOfString; I: Integer;
+begin
+  Result := True;
+  if PlanFile = '' then Exit;
+  if CurPageID = ScopePage.ID then begin
+    if ScopePage.SelectedValueIndex = 1 then Scope := 'system' else Scope := 'user';
+    Result := Request('scope', Scope + ',' + IntToStr(WizardForm.Handle));
+    ScopeAuthorized := Result;
+    if Result then WizardForm.DirEdit.Text := GetIniString('setup', Scope + 'Dir', '', PlanFile);
+  end else if CurPageID = wpReady then begin
+    Result := False;
+    if PlanComplete then Exit;
+    CancelRequested := False;
+    Applying := True;
+    Progress.Show;
+    WizardForm.CancelButton.Visible := True;
+    WizardForm.CancelButton.Enabled := False;
+    try
+      if CleanupPending then Progress.SetText('Removing the previous installation...', '')
+      else Progress.SetText('Preparing the installation...', '');
+      Progress.SetProgress(0, 1);
+      TimerID := StartTimer(0, 0, 150, CreateCallback(@RefreshProgress));
+      if CleanupPending then PlanComplete := Request('cleanup', WizardSelectedTasks(False))
+      else PlanComplete := Request('install', WizardSelectedTasks(False));
+    finally
+      StopTimer(0, TimerID);
+      Applying := False;
+      if CancelRequested then CancelSignal.Free;
+      Progress.Hide;
+    end;
+    if CancelRequested and not PlanComplete and FileExists(PlanFile + '.cancelled') then begin
+      DeleteFile(PlanFile + '.cancelled');
+      WizardForm.ReadyLabel.Caption := 'Installation cancelled. Click Back to review your choices or Cancel to exit.';
+      Exit;
+    end;
+    if not PlanComplete and FileExists(PlanFile + '.cleanup') then begin
+      CleanupPending := True;
+      WizardForm.PageNameLabel.Caption := 'Previous installation cleanup incomplete';
+      WizardForm.PageDescriptionLabel.Caption := 'The replacement was installed. Review the cleanup error below.';
+      WizardForm.ReadyLabel.Caption := 'Close any running copies of Codex and retry. Exiting now may leave two installations.';
+      WizardForm.ReadyMemo.Lines.Clear;
+      if LoadStringsFromFile(PlanFile + '.cleanup', Details) then
+        for I := 0 to GetArrayLength(Details) - 1 do WizardForm.ReadyMemo.Lines.Add(Details[I]);
+      WizardForm.BackButton.Hide;
+      WizardForm.NextButton.Caption := 'Retry cleanup';
+    end;
+    if PlanComplete then begin
+      WizardForm.PageNameLabel.Caption := 'Completing the Codex Setup Wizard';
+      WizardForm.PageDescriptionLabel.Caption := 'Codex has been installed on your computer.';
+      WizardForm.ReadyLabel.Caption := 'Click Finish to exit Setup.';
+      WizardForm.ReadyMemo.Hide;
+      RunAfter := TNewCheckBox.Create(WizardForm);
+      RunAfter.Parent := WizardForm.ReadyMemo.Parent;
+      RunAfter.SetBounds(WizardForm.ReadyMemo.Left, WizardForm.ReadyMemo.Top, WizardForm.ReadyMemo.Width, ScaleY(24));
+      RunAfter.Caption := 'Launch Codex';
+      RunAfter.Checked := True;
+      WizardForm.BackButton.Hide;
+      WizardForm.NextButton.Hide;
+      WizardForm.CancelButton.Caption := SetupMessage(msgButtonFinish);
+      WizardForm.CancelButton.Default := True;
+      WizardForm.ActiveControl := WizardForm.CancelButton;
+    end;
+  end;
+end;
+
+procedure CancelButtonClick(CurPageID: Integer; var Cancel, Confirm: Boolean);
+begin
+  if Reporting and CancelRequested then begin
+    Confirm := False;
+    Exit;
+  end;
+  if Applying then begin
+    Cancel := False;
+    Confirm := False;
+    if not CancelRequested and WizardForm.CancelButton.Enabled then begin
+      CancelRequested := True;
+      WizardForm.CancelButton.Enabled := False;
+      CancelSignal := CreateCustomForm;
+      CancelSignal.Caption := 'Codex Cancel ' + Session;
+      PutWindowValue(CancelSignal.Handle, 'CodexCancel', 1);
+    end;
+    Exit;
+  end;
+  if PlanComplete then begin
+    if RunAfter.Checked then Request('launch', '');
+    Cancel := True;
+    Confirm := False;
+  end;
+end;
+
+function ShouldSkipPage(PageID: Integer): Boolean;
+begin
+  Result := ((FromScopeLauncher() or (PlanFile <> '')) and (PageID = wpSelectDir)) or
+    ((PlanFile <> '') and (PageID = wpSelectProgramGroup));
+end;
